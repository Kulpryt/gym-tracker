generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  username     String           @unique
  passwordHash String
  createdAt    DateTime         @default(now())
  sessions     WorkoutSession[]
  foodLogs     FoodLogEntry[]
  macroGoal    MacroGoal?
}

model Exercise {
  id                String       @id
  name              String
  category          String
  bodyPart          String
  equipment         String
  target            String
  muscleGroup       String
  secondaryMuscles  String[]
  instructions      String
  instructionSteps  String[]
  image             String
  gifUrl            String
  createdAt         DateTime     @default(now())
  sets              WorkoutSet[]

  @@index([category])
  @@index([equipment])
  @@index([target])
}

model WorkoutSession {
  id        String       @id @default(cuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  date      DateTime     @default(now())
  notes     String?
  createdAt DateTime     @default(now())
  sets      WorkoutSet[]

  @@index([userId])
}

model WorkoutSet {
  id          String         @id @default(cuid())
  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  exercise    Exercise       @relation(fields: [exerciseId], references: [id])
  exerciseId  String
  setNumber   Int
  weightKg    Float?
  reps        Int?
  rpe         Float?
  notes       String?
  completedAt DateTime       @default(now())

  @@index([sessionId])
  @@index([exerciseId])
}

model FoodProduct {
  barcode       String         @id
  name          String
  brand         String?
  imageUrl      String?
  kcalPer100    Float
  proteinPer100 Float
  carbsPer100   Float
  fatPer100     Float
  updatedAt     DateTime       @updatedAt
  logs          FoodLogEntry[]
}

model FoodLogEntry {
  id         String       @id @default(cuid())
  userId     String?
  user       User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime     @default(now())
  mealType   String
  product    FoodProduct? @relation(fields: [barcode], references: [barcode])
  barcode    String?
  customName String?
  quantityG  Float
  kcal       Float
  protein    Float
  carbs      Float
  fat        Float
  createdAt  DateTime     @default(now())

  @@index([date])
  @@index([userId])
}

model MacroGoal {
  id            String   @id @default(cuid())
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kcal          Float    @default(2200)
  protein       Float    @default(150)
  carbs         Float    @default(220)
  fat           Float    @default(70)
  currentWeight Float    @default(75)
  targetWeight  Float    @default(75)
  goalType      String   @default("maintien")
  height        Float    @default(175)
  age           Int      @default(25)
  gender        String   @default("male")
  activityLevel Float    @default(1.375)
}
